rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User root profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Gear subcollection
      match /gear/{gearId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(gearId);
      }

      // Shoots subcollection
      match /shoots/{shootId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(shootId);
      }

      // Packing checklist subcollection
      match /packing/{packingId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(packingId);
      }

      // Moodboards subcollection
      match /moodboards/{moodboardId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(moodboardId);
      }
    }
  }
}
